{
  "expo": {
    "name": "KeypassGuard",
    "slug": "KeypassGuard_App",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "scheme": "keypassguardapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "bundleIdentifier": "com.caldwell.keypassguard",
      "icon": {
        "dark": "./assets/ios-dark.png",
        "light": "./assets/ios-light.png",
        "tinted": "./assets/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Use your camera in order to add images to records.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select images for add to your records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#051923"
      },
      "package": "com.caldwell.keypassguard",
      "versionCode": 8,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
            }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.379288000176-pfttrjo0a62mlcgghmfgaa3fjtsru5s8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b62dacb-2df3-4bd7-a10a-5eb883125876"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5b62dacb-2df3-4bd7-a10a-5eb883125876"
    }
  }
}
